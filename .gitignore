node_modules/
.next/
dist/
target/
.env
.env.*
!.env.example
logs/
data/
coverage/
*.tsbuildinfo
# Signer private keys — NEVER commit (key material)
/Priv_key_*/
*.pem
*_secret_key.pem
keys/
# Vercel CLI link state. `vercel` writes projectId/orgId here on first run, and
# it also drops a generated vercel.json at the repo root describing whatever
# "services" it auto-detected in the monorepo — which is how a dashboard deploy
# ended up trying to build packages/middleware. Neither belongs in the repo.
.vercel

# Registry credentials — an .npmrc carries a plaintext _authToken.
# Two npm accounts are in play on this machine, so a per-project .npmrc
# is a reasonable thing to create; it must never be committed.
.npmrc
.npmrc.*
!.npmrc.example

# Internal planning docs — kept local, not published
/AgentGate-PRD-Solo-Build-Plan.md

# npm pack artefacts
*.tgz

# rendered demo video — regenerate from docs/video/pipeline/
docs/video/*.mp4
docs/video/*.png
docs/video/vo/*.mp3
docs/video/vo/*.wav

# Throwaway buyer for scripts/smoke-live-buy.ts — pocket change, never a real wallet.
.agentgate-smoke-buyer.key
