AGENTGATE_MODE=mock
# --- ports ---
DEVNET_PORT=4030
ORACLE_PORT=4010
MIDDLEWARE_PORT=4021
DASHBOARD_PORT=3000
# --- mock mode ---
DEVNET_URL=http://localhost:4030
# --- middleware ---
AGENTGATE_ADMIN_TOKEN=dev-admin-token        # MUST be changed in live mode (config refuses default)
INVOICE_TTL_MS=300000                        # how long a QUOTED price stands
INVOICE_REDEMPTION_WINDOW_MS=86400000        # how long a SETTLED payment may still be collected (default 24h).
                                             # Must be >= INVOICE_TTL_MS. These are different questions: a payment
                                             # confirmed on-chain inside the TTL but presented after it used to be
                                             # refused outright, and PaymentRouter has no refund path.
INVOICE_STORE_PATH=                          # REQUIRED in live mode: JSON file path -> issued invoices survive gateway restarts (FileInvoiceStore). Live boot is refused when unset: an in-memory store loses every in-flight payment on restart, and PaymentRouter has no refund path
ATTESTATION_QUEUE_PATH=                      # optional: JSON file path → pending attestations survive restarts & replay on boot (FileAttestationQueue, F7); empty = in-memory
UPSTREAMS_PATH=                               # optional: where the gateway keeps its service-id -> upstream map (default packages/middleware/data/upstreams.json). Set it per gateway when two run on one box (one per network): ids start at 1 on every chain
UPSTREAM_TIMEOUT_MS=30000
LOG_LEVEL=info                               # debug|info|warn|error (read by the shared logger)
TRUST_PROXY=0                                # number of trusted reverse-proxy hops; set 1 behind a single Railway/Vercel proxy so rate limiting keys off the real client IP (never set above the real hop count)
# --- live mode: pick the CHAIN IDENTITY as one unit ---
# ZG_NETWORK_PROFILE selects chain id + RPC + explorer + all three contract
# addresses together. Mixing values from two networks is not a configuration,
# it is a way to burn money: a value-bearing call to an address with no code
# SUCCEEDS on-chain and is unrecoverable.
#   mainnet (default) = 0G Mainnet, chain 16661 -- what the hosted gateway and
#                       dashboard serve since 2026-09-15
#   galileo           = 0G Galileo Testnet, chain 16602 -- the same contracts,
#                       for testing with faucet OG (gateway: 0g-gateway.mdloglabs.org)
ZG_NETWORK_PROFILE=
# The individual vars below override the profile for a custom/self-hosted
# deployment. Leave them unset to inherit the profile — and note the client now
# asserts eth_chainId and that each address holds code before it will sign.
ZG_RPC_URL=
ZG_CHAIN_ID=
ZG_NETWORK=
ZG_EXPLORER_URL=
REGISTRY_CONTRACT_ADDRESS=
PAYMENT_ROUTER_ADDRESS=
SPEND_GUARD_ADDRESS=
ZG_RECEIPT_TIMEOUT_MS=180000                  # how long to keep asking for a receipt before calling it unconfirmed. 0G reports a block BEFORE its receipts are queryable and the public RPC is load-balanced, so "not found" usually means "not from this peer yet" -- giving up early once returned TX_RECEIPT_UNCONFIRMED for a payment that had already landed, and the buyer was charged and served nothing
CONTRACTS_DEPLOY_BLOCK=                       # only with your OWN contracts: the block they were deployed in -- every eth_getLogs history read starts there. The profile already knows its own
ACTIVITY_LOOKBACK_BLOCKS=                     # leave unset. An optional cap (blocks back from the head) for an RPC that rejects wide getLogs ranges -- both 0G RPCs do not -- and any cap blanks the activity feed once the service idles longer than it (~0.5 s/block)
GATE_SIGNER_KEY=                              # middleware/attestor key (0x + 64 hex) -- NEVER commit
BUYER_SIGNER_KEY=                             # buyer key (0x + 64 hex) -- NEVER commit -- buyer agent + `agentgate buy` (also via --key)
SELLER_SIGNER_KEY=                            # CLI / seller key (0x + 64 hex) -- NEVER commit
# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# --- oracle ---
ORACLE_STATIC=0                               # 1 = serve deterministic fixture data (offline demo)
# --- buyer spend limits ---
# Operator-set ceiling enforced inside `agentgate buy` and the MCP agentgate_buy
# tool BEFORE any network call or signing. An autonomous agent's own maxOg may
# only LOWER this, never raise it — otherwise the only cap on a prompt-injected
# agent is a price the attacker chose when registering their service.
AGENTGATE_MAX_SPEND_OG=
BUYER_BUDGET_OG=5
# --- demo accounts (mock mode only) ---
MOCK_BUYER_ACCOUNT=
MOCK_SELLER_ACCOUNT=
